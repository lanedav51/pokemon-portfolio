# Google service account used for both Sheets and Vision (OCR) APIs.
# See README.md "Google Cloud setup" for how to create these.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# The spreadsheet ID from your Google Sheet's URL:
# https://docs.google.com/spreadsheets/d/THIS_PART_IS_THE_ID/edit
GOOGLE_SHEET_ID=

# Optional but recommended: raises pokemontcg.io rate limits from 20/min to
# 20,000/day. Get a free key at https://dev.pokemontcg.io/
POKEMONTCG_API_KEY=
